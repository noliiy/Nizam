<Window x:Class="Nizam.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nizam" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen">
  <!-- Belge: WPF ana kabuk (Windows'ta derlenecek). Bağlama: MainViewModel -->
  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}" />
      </StatusBarItem>
    </StatusBar>
    <Border DockPanel.Dock="Left" Width="220" Background="#1F2A37" Padding="12">
      <StackPanel>
        <TextBlock Text="Nizam" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
        <ItemsControl ItemsSource="{Binding NavigationItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Title}"
                      Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding Key}"
                      Margin="0,4" HorizontalContentAlignment="Left" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <ContentControl x:Name="MainContent" />
  </DockPanel>
</Window>
