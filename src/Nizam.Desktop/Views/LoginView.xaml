<UserControl x:Class="Nizam.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Belge: Giriş ekranı — LoginViewModel -->
  <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
    <StackPanel>
      <TextBlock Text="{Binding TitleLabel}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
      <TextBlock Text="{Binding EmailLabel}" />
      <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
      <TextBlock Text="{Binding PasswordLabel}" />
      <PasswordBox x:Name="PasswordBox" Margin="0,4,0,12" />
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,0,0,8" />
      <Button Content="{Binding LoginButtonLabel}" Command="{Binding LoginCommand}" IsDefault="True" Height="36" />
    </StackPanel>
  </Grid>
</UserControl>
