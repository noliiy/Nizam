<UserControl x:Class="Nizam.Desktop.Views.ProjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Belge: Proje listesi — ProjectListViewModel -->
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="{Binding TitleLabel}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
      <TextBlock Text="{Binding CodeLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
      <TextBox Text="{Binding NewProjectCode}" Width="100" Margin="0,0,8,0" />
      <TextBlock Text="{Binding NameLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
      <TextBox Text="{Binding NewProjectName}" Width="200" Margin="0,0,8,0" />
      <Button Content="{Binding NewProjectButtonLabel}" Command="{Binding NewProjectCommand}" />
    </StackPanel>
    <ListView ItemsSource="{Binding Projects}">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Kod" DisplayMemberBinding="{Binding ProjectCode}" Width="120" />
          <GridViewColumn Header="Ad" DisplayMemberBinding="{Binding Name}" Width="280" />
          <GridViewColumn Header="Tamamlanma %" DisplayMemberBinding="{Binding PercentComplete}" Width="120" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</UserControl>
